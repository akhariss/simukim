APP_NAME="SIMUKIM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# 1. Portal SSO Kampus / Bridge (Otentikasi Login Token Mahasantri & Dosen via SSO)
CAMPUS_API_BASE_URL=https://bridge.uinssc.ac.id
BRIDGE_API_URL=https://bridge.uinssc.ac.id
CAMPUS_API_TIMEOUT=5
BRIDGE_API_TIMEOUT=5
CAMPUS_API_CONNECT_TIMEOUT=1
CAMPUS_API_VERIFY_SSL=false
BRIDGE_API_VERIFY_SSL=false
CAMPUS_API_HEALTH_CACHE_TTL=300

# 2. Pangkalan Data SAHAJA Asrama (Sinkronisasi Mukim & BRIVA via API Key)
SAHAJA_API_URL=https://sahaja.uinssc.ac.id
SAHAJA_API_KEY=your-sahaja-api-key-here
SAHAJA_API_TIMEOUT=5
SAHAJA_API_VERIFY_SSL=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mahad.local"
MAIL_FROM_NAME="${APP_NAME}"

